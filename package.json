{
  "name": "bootpack",
  "version": "1.1.0",
  "private": true,
  "author": "ZachTRice",
  "description": "A Bootstrap 5 and webpack 5 starter for multi-page static websites.",
  "license": "MIT",
  "homepage": "https://github.com/bootpack/bootpack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bootpack/bootpack.git"
  },
  "bugs": {
    "url": "https://github.com/bootpack/bootpack/issues"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "start": "webpack serve --mode development",
    "preview": "node tools/preview.js",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "report:css": "node tools/css-report.js",
    "watch": "webpack --mode development --watch",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "lint": "npm run lint:js && npm run lint:styles",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "check": "npm run lint && npm test && npm run build",
    "compress:images": "node tools/compress-images.js",
    "generate:images": "node tools/generate-images.js",
    "generate:images:multiple": "node tools/generate-images.js --multiple"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.5.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "sharp": "^0.35.4",
    "sirv": "^3.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
